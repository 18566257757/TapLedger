# Copy to .env only for local development. scripts/setup.ps1 creates a private
# runtime configuration without overwriting existing secrets.
TAPLEDGER_ENVIRONMENT=development
TAPLEDGER_HOST=127.0.0.1
TAPLEDGER_PORT=8787
TAPLEDGER_DATA_DIR=
TAPLEDGER_BACKUP_DIR=
TAPLEDGER_SESSION_SECRET=
TAPLEDGER_SHORTCUT_TOKEN=
TAPLEDGER_TAILSCALE_BASE_URL=
TAPLEDGER_LOG_LEVEL=INFO
